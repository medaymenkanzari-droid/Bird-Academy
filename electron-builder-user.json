{
  "appId": "com.birdacademy.breeder",
  "productName": "Bird Academy - Avian ERP",
  "directories": {
    "output": "release-user"
  },
  "files": [
    "dist/**/*",
    "dist_user/**/*",
    "electron-main.cjs",
    "preload.cjs"
  ],
  "protocols": [
    {
      "name": "Bird Academy Protocol",
      "schemes": [
        "birdacademy"
      ]
    }
  ],
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "build/icons/icon-user.ico",
    "executableName": "Bird-Academy-User"
  },
  "nsis": {
    "oneClick": true,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": false,
    "deleteAppDataOnUninstall": false,
    "installerIcon": "build/icons/icon-user.ico",
    "uninstallerIcon": "build/icons/icon-user.ico",
    "include": "packaging/installer.nsh"
  },
  "extraMetadata": {
    "name": "bird-academy-user",
    "version": "1.3.6"
  }
}
